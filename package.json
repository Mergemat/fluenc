    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.64.1",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4",
    "vite": "^8.3.2",
    "workbox-build": "^7.4.1"
