    "@tanstack/react-db": "1.0.0-rc.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.7.12",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.50.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
