{
  "name": "fluenc",
  "private": true,
  "description": "A Mandarin study app built on the Hanzi Movie Method",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mergemat/fluenc.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "bench": "bun scripts/bench.ts",
    "build": "bun scripts/build.ts",
    "check": "ultracite check",
    "data:font": "bun scripts/sync-hanzi-font.ts && bun scripts/build-fonts.ts",
    "data:sync": "bun scripts/sync-curriculum.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun scripts/setup.ts --reset",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "vite dev",
    "doctor": "react-doctor",
    "fix": "ultracite fix",
    "focus": "bun scripts/focus.ts",
    "preview": "bun scripts/preview.ts",
    "setup": "bun scripts/setup.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@ionic/core": "^9.0.6",
    "@libsql/client": "^0.18.0",
