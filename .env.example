# Required in every environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Better Auth. Generate the secret with openssl rand -base64 32; the URL is the app's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ELEVENLABS_VOICE_ID=
ELEVENLABS_API_KEY=

# Local ElevenLabs audio caching. Vercel injects Blob OIDC credentials in production.
BLOB_READ_WRITE_TOKEN=

# Daily Web Push reminders. Generate one key pair with bunx web-push generate-vapid-keys --json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto address. Use a public HTTPS URL, not localhost.
VAPID_SUBJECT=https://example.com
CRON_SECRET=

# The account `bun run focus` and `bun run claim` work on.
FLUENC_EMAIL=
