# `bun run setup` copies this file to .env and fills in the blanks it can.

# --- Required ---------------------------------------------------------------

# Database. Locally a SQLite file such as file:local.db, which needs no token.
# In production, a Turso database URL and its token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs sessions. Any long random string; `bun run setup` generates one.
BETTER_AUTH_SECRET=
# The app's public URL in production, such as https://fluenc.example.com.
# Leave blank locally: the URL is then taken from each request.
BETTER_AUTH_URL=

# --- Optional: spoken audio --------------------------------------------------

# Words and sentences are spoken by ElevenLabs. Without these, single characters
# still play from the bundled recordings.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Stores generated audio in Vercel Blob so each text is generated once.
# Vercel sets this for you in production.
BLOB_READ_WRITE_TOKEN=

# --- Optional: daily review reminders ----------------------------------------

# One key pair, from `bunx web-push generate-vapid-keys --json`. Keep the same
# pair across deploys; a new one makes every device subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: a mailto: address or a public https:// URL.
VAPID_SUBJECT=
# Any random string. Vercel sends it with each cron request.
CRON_SECRET=

# --- Scripts -------------------------------------------------------------------

# The account `bun run focus` and `bun run claim` work on.
FLUENC_EMAIL=
